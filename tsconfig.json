{
  // Usado pela Vercel (@vercel/node) ao compilar a função api/index.ts e o
  // código do servidor que ela importa. Mesmas opções de server/tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["api", "server/src"]
}
