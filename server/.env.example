# ------------------------------------------------------------------
# FinanceTech — variáveis de ambiente
# Copie para server/.env (o `npm run setup` faz isso automaticamente).
# NUNCA versione o arquivo .env.
# ------------------------------------------------------------------

# Desenvolvimento local sem PostgreSQL: banco SQLite em arquivo.
DATABASE_URL="file:./financetech.db"

# Para usar PostgreSQL localmente (ou em produção), troque por:
# DATABASE_URL="postgresql://usuario:senha@host:5432/financetech?sslmode=require"
# DIRECT_URL="postgresql://usuario:senha@host:5432/financetech?sslmode=require"
#   DATABASE_URL: conexão usada pela API (em provedores com pool, use a URL "pooled")
#   DIRECT_URL:   conexão direta usada pelas migrações (opcional; padrão = DATABASE_URL)

# Fuso horário usado para "hoje" (vencimentos, atrasos). Padrão: America/Sao_Paulo
# APP_TIMEZONE="America/Sao_Paulo"

# Porta da API local (não é usada na Vercel)
API_PORT=3333
