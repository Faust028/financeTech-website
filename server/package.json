{
  "name": "@financetech/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run env:init && node scripts/prisma.mjs generate && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "env:init": "node -e \"const f=require('fs');if(!f.existsSync('.env'))f.copyFileSync('.env.example','.env')\"",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "db:setup": "npm run env:init && node scripts/prisma.mjs db push && tsx prisma/seed.ts",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma.mjs generate",
    "build:vercel": "cd .. && npm run build:vercel && node scripts/copy-dist.mjs server/public"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
